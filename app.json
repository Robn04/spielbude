{
  "expo": {
    "name": "Spielbude",
    "slug": "Spielbude",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spielbude",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/party-pfeife.png",
      "supportsTablet": true
    },
    "web": {
      "output": "static",
      "favicon": "/dist/assets/assets/party-pfeife.053c7156883cb874c199aeb8393a28c3.png",
      "display": "standalone",
      "name": "Spielbude",
      "shortName": "Spielbude",
      "icons": [
        {
          "src": "/dist/assets/assets/party-pfeife.053c7156883cb874c199aeb8393a28c3.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/spielbude"
    }
  }
}