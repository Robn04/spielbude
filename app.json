{
  "expo": {
    "name": "Spielbude",
    "slug": "spielbude",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spielbude",
    "userInterfaceStyle": "dark",
    "web": {
      "output": "static",
      "favicon": "/spielbude/party-pfeife-rund.png",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1d1d1d",
          "image": "./assets/images/party-pfeife-rund.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/spielbude"
    }
  }
}